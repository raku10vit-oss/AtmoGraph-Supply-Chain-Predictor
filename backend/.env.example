# ─────────────────────────────────────────────────────────
#  AtmoGraph Backend — Environment Configuration
#  Copy this file to backend/.env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────

# Neo4j Connection
# Local Desktop: bolt://localhost:7687
# Neo4j Aura:    neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS — React frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
